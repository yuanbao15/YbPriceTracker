# YbPriceTracker 服务配置
# 复制本文件为 .env 后按实际情况修改：cp .env.example .env

# 服务端口
PORT=3777

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=yb_price_tracker

# 日志级别: error | warn | info | debug
LOG_LEVEL=info

# 定时任务（cron 表达式，5 段；时区固定为 Asia/Shanghai）
# 京东：每天 0点、6点、12点、18点、22点
JD_CRON=0 0,6,12,18,22 * * *
# 淘宝/天猫：每天 10点
TAOBAO_CRON=0 10 * * *
# 拼多多：每天 9点、21点
PDD_CRON=0 9,21 * * *
